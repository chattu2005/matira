rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'chattu1904@gmail.com'
      );
    }

    // Categories: Public can read active categories, Admins can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Health check / connection probe
    match /test/{docId} {
      allow read: if true;
    }

    // Products: Public can read products, Admins can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Content: Public can read branding & banners, Admins can write
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: Public can read active coupons to validate discounts, Admins can write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Profiles: Owner can read/update their own profile, Admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Customer Addresses: Owner can manage their addresses, Admin can read
    match /addresses/{addressId} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
    }

    // Orders: Anyone can create an order (supporting guest and registered checkout); Customer can read their own; Admin can manage all
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admin Registry: Signed-in users can verify admin status; Authorized admin can write
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'chattu1904@gmail.com');
    }

    // Notification Logs: Admins can inspect email/whatsapp audit logs
    match /order_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }
  }
}
